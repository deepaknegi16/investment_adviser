# Copy to .env and fill in.

# Free Gemini key (aistudio.google.com/apikey, no card) — powers the AI agents,
# chat, and RAG embeddings.
GEMINI_API_KEY=

# Optional free Groq key (console.groq.com) — fallback for chat and the
# screener when Gemini's free-tier rate limit trips.
GROQ_API_KEY=

# Login credentials for the dashboard (JWT auth). REQUIRED — the backend
# refuses to start without AUTH_PASSWORD, and refuses the old example value
# 'adviser@123' by name, because it is published in this repo.
# Generate one:
#   python3 -c "import secrets,string; a=''.join(c for c in string.ascii_letters+string.digits if c not in 'O0Il1'); print('-'.join(''.join(secrets.choice(a) for _ in range(5)) for _ in range(3)))"
AUTH_USERNAME=deepak
AUTH_PASSWORD=
# JWT signing secret is auto-generated into backend/jwt_secret.key unless set:
# JWT_SECRET=

# Optional: override the models used by the agents and chat
# ANALYST_MODEL=gemini-3.5-flash
# SCREENER_MODEL=gemini-3.5-flash-lite
# CHAT_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# --- Gold Watch email alerts (GOLDBEES) ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=you@gmail.com

# Optional: model used by the gold watch agent
# GOLD_WATCH_MODEL=gemini-3.5-flash
