# Copy to .env and fill in.

# Free Gemini key (aistudio.google.com/apikey, no card) — powers the AI agents,
# chat, and RAG embeddings.
GEMINI_API_KEY=

# Optional free Groq key (console.groq.com) — fallback for chat and the
# screener when Gemini's free-tier rate limit trips.
GROQ_API_KEY=

# Login credentials for the dashboard (JWT auth). Defaults if unset:
# AUTH_USERNAME=deepak
# AUTH_PASSWORD=adviser@123
# JWT signing secret is auto-generated into backend/jwt_secret.key unless set:
# JWT_SECRET=

# Optional: override the models used by the agents and chat
# ANALYST_MODEL=gemini-3.5-flash
# SCREENER_MODEL=gemini-3.5-flash-lite
# CHAT_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
